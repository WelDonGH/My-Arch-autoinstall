!#/usr/bin/env bash

# This is the Part 1 of the WeldonGH's Arch Linux autoinstall, btw.
# Make sure to chmod +x this.

# Programs that will be pacstrap'd:
# base linux linux-firmware base-devel sof-firmware git vim fastfetch networkmanager efibootmgr

# Here we chose our partitions. My preference is ext4 for my root partition.
cfdisk /dev/sda

# Here we made our partitions. Easy right?
mkfs.fat -F32 -n BOOT /dev/sda1
mkfs.ext4 -L root /dev/sda3
mkswap -L swap /dev/sda2

# And mounted them.
mount /dev/sda3 /mnt
mount -m /dev/sda1 /mnt/boot
swapon /dev/sda2

# Here we installed the essentials.
pacstrap /mnt base linux linux-firmware base-devel sof-firmware git vim fastfetch networkmanager efibootmgr

# Something for the kernel to recognize the partitions and then mount them, idk really.
genfstab -U /mnt >> /mnt/etc/fstab

# Moving the next part to the directory for temporary files.
mv autoinstall_pt2 /mnt/tmp/autoinstall_pt2

# And finally we enter the chroot environment.
arch-chroot -S /mnt

